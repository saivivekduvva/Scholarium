# Security & Deployment
SECRET_KEY=django-insecure-replace-in-production
DEBUG=False
ALLOWED_HOSTS=yourdomain.com,api.yourdomain.com
CORS_ALLOWED_ORIGINS=https://yourdomain.com
CSRF_TRUSTED_ORIGINS=https://yourdomain.com
SECURE_SSL_REDIRECT=True

# Database
DB_NAME=scholarium_db
DB_USER=scholarium_user
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=3306

# NoSQL & LLM
MONGO_URI=mongodb://localhost:27017/scholarium_logs
LLM_PROVIDER=gemini
GEMINI_API_KEY=
